logname "extracted/e1/e1_vice_room0_live_frame_probe.log"
log on
device c:
bank ram
bload "extracted/e1/e1_room0_ready_memory.bin" 0 $0000
bank cpu
> $0000 $2f
> $0001 $35
> $0002 $ff $ff $ff $ff
> $009d $ff $ff $ff $ff
; Run the C400 record scan and the following initialization calls.
r pc=$621b, a=$00, x=$00, y=$00, sp=$ff, fl=$20
until $6298
radix h
m $0002 $0019
m $009d $00a0
m $c400 $c407
m $5e19 $5e34
; Apply the completed zero-page frame through the real IRQ VIC transfer loop.
> $dd02 $3f
> $dd00 $03
> $d011 $1b
> $d016 $08
> $d018 $18
r pc=$4d46, a=$00, x=$00, y=$00, sp=$ff, fl=$20
until $4d81
io $d000
; Let VIC-II render stable raster frames, then capture its output.
> $0200 $ea $4c $00 $02
r pc=$0200
radix d
step 20000
screenshot "extracted/e1/e1_vice_room0_live_frame" 2
r
q
