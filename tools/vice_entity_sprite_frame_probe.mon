logname "extracted/e1/e1_vice_entity_sprite_frame_probe.log"
log on
device c:
bank ram
bload "extracted/e1/e1_room0_ready_memory.bin" 0 $0000
bank cpu
> $0000 $2f
> $0001 $35
; Initialize C400 records and the four parallel actor-field arrays.
r pc=$621b, a=$00, x=$00, y=$00, sp=$ff, fl=$20
until $628c
radix h
m $0002 $0019
m $c400 $c407
; Build one sprite frame from those initialized arrays.
> $0200 $20 $1e $5b $4c $00 $04
r pc=$0200, a=$00, x=$00, y=$00, sp=$ff, fl=$20
stopwatch reset
until $0400
m $5e01 $5e18
m $5e19 $5e34
r
q
